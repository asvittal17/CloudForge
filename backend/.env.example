# Copy to .env and fill in real values. Never commit real secrets.

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL, local dev via docker compose) ---
DB_USER=cloudforge
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=cloudforge

# --- Admin bootstrap ---
# Comma-separated emails promoted to role="admin" at server startup
# if those accounts already exist (self-registration creates them).
CLOUDFORGE_ADMIN_EMAILS=

# --- Terraform deployment safety ---
# Real terraform apply runs are disabled unless explicitly "1".
CLOUDFORGE_ALLOW_TERRAFORM_APPLY=0

# --- Target AWS infrastructure (real applies only) ---
# Passed to Terraform via TF_VAR_database_password; never written to
# Terraform files or API responses.
CLOUDFORGE_RDS_PASSWORD=

# --- Protected Terraform storage (saved plans, local dev state) ---
# Windows dev default: D:\CloudForge-data\terraform
CLOUDFORGE_TERRAFORM_STORAGE=

# --- Error monitoring tuning (optional) ---
ERROR_DEDUPE_WINDOW_MINUTES=5
ERROR_MAX_ROWS=5000
